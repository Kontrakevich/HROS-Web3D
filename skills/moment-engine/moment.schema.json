{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hros.local/schemas/moment.v0.4.json",
  "title": "HROS Moment v0.4",
  "type": "object",
  "required": ["title", "date", "participantIds", "relationshipEffect", "details", "source"],
  "properties": {
    "id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "date": { "type": "string", "format": "date" },
    "period": { "type": "string" },
    "description": { "type": "string" },
    "participantIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "emotions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "significance": { "type": "integer", "minimum": 0, "maximum": 100 },
    "relationshipEffect": {
      "type": "object",
      "required": ["closeness", "trust", "tension"],
      "properties": {
        "closeness": { "type": "number", "minimum": -1, "maximum": 1 },
        "trust": { "type": "number", "minimum": -1, "maximum": 1 },
        "tension": { "type": "number", "minimum": -1, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "properties": {
        "meaning": { "type": "string" },
        "place": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "mimeType": { "type": ["string", "null"] },
              "size": { "type": ["integer", "null"], "minimum": 0 },
              "lastModified": { "type": ["integer", "null"], "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "finalizedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["draft", "observed", "hypothesis", "confirmed", "finalized", "archived"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
