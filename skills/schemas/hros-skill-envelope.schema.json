{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hros.local/schemas/hros-skill-envelope-v1.json",
  "title": "HROS Skill Envelope v1",
  "type": "object",
  "required": ["skill", "contractVersion", "traceId", "input", "privacy"],
  "properties": {
    "skill": {"type": "string", "minLength": 1},
    "contractVersion": {"const": "1.0.0"},
    "traceId": {"type": "string", "minLength": 8},
    "workspaceId": {"type": ["string", "null"]},
    "actorId": {"type": ["string", "null"]},
    "idempotencyKey": {"type": ["string", "null"]},
    "privacy": {
      "type": "object",
      "required": ["visibility"],
      "properties": {
        "visibility": {"enum": ["private", "shared_with_partner", "shared", "group"]},
        "consentPolicyIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "input": {"type": "object"},
    "result": {"type": "object"},
    "diagnostics": {
      "type": "object",
      "properties": {
        "status": {"enum": ["ok", "warning", "error"]},
        "code": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
