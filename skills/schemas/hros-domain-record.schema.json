{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hros.local/schemas/hros-domain-record-v1.json",
  "title": "HROS Domain Record v1",
  "type": "object",
  "required": ["id", "kind", "statement", "status", "confidence", "visibility", "source", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["evidence", "fact", "perspective", "action", "person_facet", "relationship_state", "observation", "hypothesis", "verification", "pattern", "principle", "original_memory", "semantic_memory", "living_memory", "interview_session", "interview_question", "interview_answer", "book_chapter", "narrative_fragment", "consent_policy"]},
    "statement": {"type": "string", "minLength": 1},
    "subjectIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relationshipIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "momentIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "perspectiveOwnerId": {"type": ["string", "null"]},
    "status": {"enum": ["draft", "observed", "hypothesis", "confirmed", "disputed", "finalized", "archived"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "visibility": {"enum": ["private", "shared_with_partner", "shared", "group"]},
    "source": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {"kind": {"type": "string"}, "label": {"type": "string"}},
      "additionalProperties": true
    },
    "evidenceIds": {"type": "array", "items": {"type": "string"}},
    "supportsIds": {"type": "array", "items": {"type": "string"}},
    "contradictsIds": {"type": "array", "items": {"type": "string"}},
    "data": {"type": "object"},
    "version": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "perspective"}}},
      "then": {"required": ["perspectiveOwnerId"], "properties": {"perspectiveOwnerId": {"type": "string", "minLength": 1}}}
    }
  ],
  "additionalProperties": false
}
