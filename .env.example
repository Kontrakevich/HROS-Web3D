# Copy to .env for Docker. Never commit the real .env file.
POSTGRES_DB=hros
POSTGRES_USER=hros
POSTGRES_PASSWORD=replace_with_a_long_random_local_password
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Choose one protected server-side provider. Never put these keys into frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Alternative provider through the OpenAI-compatible API.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8088

# OpenAI Agents SDK tracing is disabled by default because HROS conversations are private.
OPENAI_TRACING_ENABLED=0

# Optional non-Docker backend override:
# DATABASE_URL=sqlite:///./hros.db
